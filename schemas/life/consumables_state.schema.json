{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snowfall-life-engine.invalid/schemas/life/consumables_state.schema.json",
  "title": "ConsumablesState",
  "description": "Coarse consumable stock snapshot. Closed status enum only; no exact counts, grams, ml, brands, expiry, or prices.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "character_id",
    "revision",
    "state_hash",
    "as_of",
    "provenance",
    "stocks"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "domain": { "type": "string", "const": "consumables" },
    "character_id": { "type": "string", "minLength": 1 },
    "revision": {
      "type": "string",
      "minLength": 1,
      "description": "Content-derived identity; equals state_hash for ConsumablesState v1"
    },
    "state_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "as_of": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "provenance.schema.json" },
    "stocks": {
      "type": "array",
      "description": "Unordered by consumable_id. Empty is valid.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consumable_id", "status"],
        "properties": {
          "consumable_id": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["UNKNOWN", "AVAILABLE", "LOW", "OUT"]
          }
        }
      }
    }
  }
}
